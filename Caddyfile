# ============================================================
#  Caddyfile : 외부의 https/wss 요청을 받아 내부 Go 서버(8080)로 전달합니다.
#  Caddy 는 웹소켓(wss) 연결도 별도 설정 없이 자동으로 통과시켜 줍니다.
# ============================================================

# ---------- [A] 내 PC 로컬 테스트용 (기본 활성화) ----------
# localhost 로 접속하면 Caddy 가 "내부 인증기관"으로 임시 인증서를 만들어 줍니다.
# 접속 주소: https://localhost  /  wss://localhost/ws  (포트 번호를 붙이지 않습니다)
localhost {
	# 들어온 모든 요청을 내 PC 안의 Go 서버(8080)로 전달합니다.
	reverse_proxy 127.0.0.1:8080
}

# ---------- [B] 클라우드(진짜 도메인) 배포용 ----------
# 사용법: 위 [A] 블록 전체를 지우거나 앞에 # 를 붙이고, 아래 블록의 # 를 지운 뒤
#         game.내도메인.com 을 실제 도메인으로 바꾸세요.
# 필요 조건: (1) 도메인의 A 레코드가 서버 공인 IP를 가리킬 것
#            (2) 서버 방화벽에서 80, 443 포트가 열려 있을 것 (인증서 자동 발급에 80/443 이 모두 필요합니다)
# 이 조건이 맞으면 Let's Encrypt 인증서를 Caddy 가 자동 발급하고 자동 갱신합니다.
#
# game.내도메인.com {
# 	reverse_proxy 127.0.0.1:8080
# }